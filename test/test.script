go.property("test_vector", vmath.vector4(1, 2, 3, 4))
go.property("test_quat", vmath.quat())

local time = 0

-- Helper function to check if values are approximately equal
local function is_equal(values, tolerance)
	tolerance = tolerance or 0.05
	local a = values[1]
	for _, b in ipairs(values) do
		if math.abs(a - b) > tolerance then
			return false
		end
	end
	return true
end

-- Helper function to format values for error messages
local function format_values(values)
	return table.concat(values, ", ")
end

-- Test function for position-related functions
local function test_position(url, vec_in)
	-- Set position using different methods
	go.set_position_t(url, vec_in)
	go.set_position_x(url, vec_in.x)
	go.set_position_y(url, vec_in.y)
	go.set_position_z(url, vec_in.z)

	-- Get position using different methods
	local p1_x, p1_y, p1_z = go.get_position_r(url)
	local p2_x, p2_y, p2_z = go.get_position_x(url), go.get_position_y(url), go.get_position_z(url)
	local p3_out = { x = 0, y = 0, z = 0 }
	go.get_position_t(url, p3_out)

	-- Collect all x, y, z values
	local x_values = { vec_in.x, p1_x, p2_x, p3_out.x }
	local y_values = { vec_in.y, p1_y, p2_y, p3_out.y }
	local z_values = { vec_in.z, p1_z, p2_z, p3_out.z }

	-- Assert all values are equal
	assert(is_equal(x_values), "Position X values differ: " .. format_values(x_values))
	assert(is_equal(y_values), "Position Y values differ: " .. format_values(y_values))
	assert(is_equal(z_values), "Position Z values differ: " .. format_values(z_values))
end

